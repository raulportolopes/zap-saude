# Copie para .env e preencha:  cp .env.example .env && nano .env

# Endereço público do bot (o DNS dele precisa apontar para o IP da VPS)
# Só usado com o Caddy (docker compose --profile caddy); com o Nginx da VPS, o domínio fica em deploy/nginx-bot.conf
DOMINIO=bot.magox.tech

# WhatsApp Cloud API (developers.facebook.com > seu app > WhatsApp > Configuração da API)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
# Senha que você inventa e repete no cadastro do webhook na Meta
WA_VERIFY_TOKEN=

# Opcional: passo a passo de ônibus dentro do WhatsApp (Google Cloud > Routes API)
GOOGLE_MAPS_API_KEY=

# Modelo de transcrição de áudio: tiny, base ou small (mais preciso e mais pesado)
WHISPER_MODELO=small
